rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (getUserData().role == 'admin' || getUserData().isAdmin == true || request.auth.token.email == 'tanmay.sa.thorat@gmail.com');
    }

    function isModerator() {
      return isAuthenticated() && 
        (isAdmin() || getUserData().role == 'moderator');
    }

    // Users Collection - Strictly prevent non-admins from altering role, status, or isAdmin
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId) && request.resource.data.role == 'citizen';
      allow update: if isAdmin() || (
        isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'isAdmin']))
      );
      allow delete: if isAdmin();
    }

    // Issues / Reports Collection
    match /issues/{issueId} {
      allow read: if true; // Public viewable civic feed
      allow create: if true; // Allows citizens & guests to report issues
      allow update: if isAuthenticated();
      allow delete: if isAdmin();

      // Verifications subcollection
      match /verifications/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // Reports collection alias
    match /reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Activity Logs Collection
    match /activityLogs/{logId} {
      allow read: if isModerator();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories Collection
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
